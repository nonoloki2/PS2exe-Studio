<Application x:Class="PS2EXE.Studio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#15181F"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#20242D"/>
    <SolidColorBrush x:Key="InputBrush" Color="#2D323D"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3979E5"/>
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource WindowBrush}"/>
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#FAFBFD"/>
      <Setter Property="Background" Value="{StaticResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="#3A4351"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#F4F6FA"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#15181F"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
  </Application.Resources>
</Application>